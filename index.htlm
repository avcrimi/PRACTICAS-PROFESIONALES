<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Prácticas Profesionales - Acceso</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #1a252f; margin: 0; display: flex; justify-content: center; align-items: center; min-height: 100vh; }
        .card-login { background: white; padding: 30px; border-radius: 10px; width: 100%; max-width: 400px; box-shadow: 0 4px 15px rgba(0,0,0,0.2); }
        .card-login h2 { margin-top: 0; color: #2c3e50; text-align: center; }
        .form-group { margin-bottom: 15px; }
        .form-group label { display: block; margin-bottom: 5px; font-size: 13px; font-weight: bold; color: #34495e; }
        .form-group input, .form-group select { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; box-sizing: border-box; }
        .btn-main { width: 100%; padding: 12px; background: #27ae60; color: white; border: none; border-radius: 5px; font-size: 16px; font-weight: bold; cursor: pointer; }
        .btn-main:hover { background: #219150; }
    </style>
</head>
<body>

<div class="card-login">
    <h2>Ingreso a Prácticas</h2>
    <p style="text-align: center; color: #7f8c8d; font-size: 13px;">Ingresá tu nombre y apellido para acceder a tu panel.</p>
    
    <form id="auth-form">
        <div class="form-group">
            <label>Nombre y Apellido</label>
            <input type="text" id="nombreCompleto" required placeholder="Ej: Agostina Vachino">
        </div>

        <div class="form-group">
            <label>Carrera</label>
            <select id="carrera">
                <option value="Criminología y Seguridad">Criminología y Seguridad</option>
                <option value="Abogacía">Abogacía</option>
                <option value="Otra">Otra Carrera</option>
            </select>
        </div>

        <button type="submit" class="btn-main" id="btn-submit">Ingresar</button>
    </form>
</div>

<script type="module">
    import { db, collection, query, where, getDocs, addDoc } from './firebase-config.js';

    const form = document.getElementById('auth-form');
    const btnSubmit = document.getElementById('btn-submit');

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const nombreInput = document.getElementById('nombreCompleto').value.trim();
        const carreraInput = document.getElementById('carrera').value;

        if (!nombreInput) {
            alert("Por favor ingresá tu nombre y apellido.");
            return;
        }

        btnSubmit.disabled = true;
        btnSubmit.innerText = "Ingresando...";

        try {
            // Buscamos si ya existe alguien con ese Nombre y Apellido
            const q = query(collection(db, "usuarios"), where("nombreCompleto", "==", nombreInput));
            const snapshot = await getDocs(q);

            let userId = "";
            let userNombre = nombreInput;
            let userCarrera = carreraInput;

            if (!snapshot.empty) {
                // Usuario existe
                const userDoc = snapshot.docs[0];
                userId = userDoc.id;
                userCarrera = userDoc.data().carrera || carreraInput;
            } else {
                // Si no existe, lo creamos automáticamente
                const nuevoUser = await addDoc(collection(db, "usuarios"), {
                    nombreCompleto: nombreInput,
                    carrera: carreraInput,
                    rol: "estudiante"
                });
                userId = nuevoUser.id;
            }

            // Guardamos la sesión localmente
            localStorage.setItem("usuario_id", userId);
            localStorage.setItem("usuario_nombre", userNombre);
            localStorage.setItem("usuario_carrera", userCarrera);

            window.location.href = "panel.html";

        } catch (error) {
            alert("Error al ingresar: " + error.message);
            btnSubmit.disabled = false;
            btnSubmit.innerText = "Ingresar";
        }
    });
</script>

</body>
</html>
